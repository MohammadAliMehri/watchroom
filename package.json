{
  "name": "watchroom",
  "version": "1.0.0",
  "description": "Synchronized video watching rooms with server-side media conversion",
  "main": "server.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "build": "npm run build:web",
    "build:web": "npm run build --prefix web",
    "dev:web": "npm run dev --prefix web",
    "lint": "npm run lint --prefix web",
    "smoke": "node scripts/smoke-test.js"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "ipaddr.js": "^2.5.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  }
}
