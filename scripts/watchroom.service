[Unit]
Description=WatchRoom v2 Media Sync Server
After=network.target watchroom-egress.service
Wants=watchroom-egress.service

[Service]
Type=simple
User=watchroom
Group=watchroom
WorkingDirectory=/opt/watchroom
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=MEDIA_DIR=/var/lib/watchroom/media
MemoryMax=1G
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
